# Environment for interactive shells. Copy to ~/.env and fill in the real values.
#
#   cp env.example ~/.env && chmod 600 ~/.env
#
# ~/.zshrc sources ~/.env with `set -a`, so everything here is exported. That
# also means these values are visible to other processes of this user; anything
# that must not be readable that way should be fetched at point of use (the
# 1Password CLI, or the Keychain) instead of being put in this file.
#
# ~/.env is gitignored and must never be committed: this repo is public.

# --- secrets -----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-REPLACE_ME

# --- not secret, just machine configuration ----------------------------------
# Name of the 1Password item holding AWS credentials.
OP_AUTH_ITEM_NAME_AWS=AWS
